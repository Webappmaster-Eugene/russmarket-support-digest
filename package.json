{
  "name": "russmarket-support-digest",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm db:build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:e2e": "playwright test",
    "smoke": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:build": "esbuild src/server/bootstrap.ts --bundle --platform=node --target=node22 --format=cjs --external:pg --outfile=.build/bootstrap.cjs",
    "db:setup": "pnpm db:build && node .build/bootstrap.cjs",
    "test:integration": "vitest run tests/integration",
    "mcp:build": "esbuild src/mcp/stdio.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=.build/support-mcp.mjs",
    "mcp:demo": "pnpm mcp:build && esbuild scripts/mcp-demo.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=.build/support-mcp-demo.mjs && node .build/support-mcp-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
